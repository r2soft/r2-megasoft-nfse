{
    "name": "r2soft/nfse-megasoft",
    "description": "Integração NFSe Megasoft ABRASF v2.04 — emissão, cancelamento e consulta via SOAP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.3",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-soap": "*",
        "robrichards/xmlseclibs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "R2soft\\MegasoftNfse\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "R2soft\\MegasoftNfse\\Tests\\": "tests/"
        }
    }
}
